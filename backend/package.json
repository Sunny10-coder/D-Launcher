{
  "name": "family-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Family Connect backend for My Little World (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute family_connect --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute family_connect --remote --file=./migrations/0001_init.sql",
    "check": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
